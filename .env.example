# Copy to .env and edit before starting:
#   cp .env.example .env

# Required. Admin password for user "admin" (min 8 chars; prefer letters+digits+symbol).
# By setting this and starting the container you accept Splunk license terms via
# SPLUNK_START_ARGS / SPLUNK_GENERAL_TERMS in docker-compose.yml.
# Review: https://www.splunk.com/en_us/legal/splunk-general-terms.html
# 登录账号密码 admin
SPLUNK_PASSWORD=soc-splunk

# Optional overrides
# SPLUNK_IMAGE_TAG=10.2.1
# SPLUNK_PLATFORM=linux/amd64
# SPLUNK_WEB_PORT=8000
# SPLUNK_MGMT_PORT=8089
# SPLUNK_MEM_LIMIT=4g
# SPLUNK_HEC_TOKEN=
SPLUNK_ROOT_ENDPOINT=/soc-splunk
SPLUNK_WEB_PORT=8001
